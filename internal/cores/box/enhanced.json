{
  "$schema": "https://github.com/jiang-zhexin/typebox/releases/latest/download/schema.json",
  "log": {
    "disabled": false,
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-bootstrap",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-cn",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🙋 Select"
      },
      {
        "tag": "dns-entertainment",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "📺 Entertainment"
      },
      {
        "tag": "dns-fake",
        "type": "fakeip",
        "inet4_range": "11.45.14.0/22",
        "inet6_range": "c19:19:8:10::/92"
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "query_type": "AAAA"
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "dns-cn"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Global",
        "server": "dns-remote"
      },
      {
        "rule_set": "@geosite-should-block",
        "action": "reject"
      },
      {
        "rule_set": "geosite-private",
        "server": "dns-local"
      },
      {
        "rule_set": [
          "geosite-netflix",
          "@geosite-netflix-detect"
        ],
        "server": "dns-entertainment"
      },
      {
        "rule_set": [
          "geosite-tld-cn",
          "geosite-category-game-platforms-download@cn",
          "geosite-connectivity-check",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "geosite-steam@cn",
          "geosite-epicgames@cn",
          "geosite-aws-cn",
          "geosite-azure@cn",
          "geosite-nvidia@cn",
          "geosite-itunes@cn",
          "geosite-paypal@cn",
          "geosite-akamai@cn",
          "geosite-linkedin@cn",
          "geosite-category-ntp",
          "@geosite-steam@cn",
          "@geosite-direct",
          "@geosite-duolingo@cn",
          "@geosite-jetbrains@cn",
          "@geosite-google-play@cn"
        ],
        "server": "dns-cn"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          },
          {
            "rule_set": [
              "geoip-cn",
              "@geoip-direct"
            ],
            "rule_set_ip_cidr_accept_empty": true,
            "ip_is_private": true
          }
        ],
        "server": "dns-remote",
        "client_subnet": "0.0.0.0/0"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "@geosite-fakeip-filter"
            ],
            "invert": true
          },
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          }
        ],
        "action": "route",
        "server": "dns-fake",
        "rewrite_ttl": 1
      }
    ],
    "final": "dns-cn",
    "independent_cache": true,
    "reverse_mapping": true
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "ip_is_private": true,
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "ip_version": 6
          }
        ],
        "action": "reject"
      },
      {
        "network": "icmp",
        "outbound": "Direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "udp",
            "port": [
              123
            ]
          },
          {
            "clash_mode": "Direct"
          }
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "inbound": [
              "dns-in"
            ]
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "🙋 Select"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "Direct"
      },
      {
        "rule_set": [
          "@geoip-direct",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "port": [
          80,
          443
        ],
        "network": "udp",
        "action": "reject"
      },
      {
        "rule_set": "@geoip-telegram@dc5",
        "outbound": "✈️ TelegramDC5(AP)"
      },
      {
        "rule_set": "@geoip-telegram@dc1",
        "outbound": "✈️ TelegramDC1(NA)"
      },
      {
        "rule_set": "@geoip-telegram@dc4",
        "outbound": "✈️ TelegramDC4(EU)"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "inbound": [
              "mixed-in"
            ],
            "invert": true
          }
        ],
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "ssh"
        ],
        "timeout": "50ms"
      },
      {
        "rule_set": "@geosite-should-block",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-private",
          "geosite-category-game-platforms-download@cn",
          "geosite-connectivity-check",
          "geosite-apple@cn",
          "geosite-steam@cn",
          "geosite-epicgames@cn",
          "geosite-aws-cn",
          "geosite-azure@cn",
          "geosite-nvidia@cn",
          "geosite-itunes@cn",
          "geosite-paypal@cn",
          "geosite-akamai@cn",
          "geosite-linkedin@cn",
          "@geosite-steam@cn",
          "@geosite-direct",
          "@geosite-duolingo@cn",
          "@geosite-jetbrains@cn",
          "@geosite-direct",
          "@geosite-google-play@cn"
        ],
        "outbound": "Direct"
      },
      {
        "rule_set": "@geosite-netflix-detect",
        "outbound": "🙋 Select"
      },
      {
        "rule_set": [
          "geosite-telegram",
          "@geosite-geolocation-eu"
