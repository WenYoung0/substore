{
  "$schema": "https://raw.githubusercontent.com/SagerNet/sing-box/v1.14.0/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "warn"
  },
  "http_clients": [
    {
      "tag": "http-bootstrap",
      "engine": "go",
      "detour": "direct-bootstrap",
      "tls": {
        "enabled": true
      }
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-mdns",
        "type": "mdns"
      },
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-bootstrap",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-cn",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "🙋 Select"
      },
      {
        "tag": "dns-ecs",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🙋 Select"
      },
      {
        "tag": "dns-fake",
        "type": "fakeip",
        "inet4_range": "11.45.14.0/22",
        "inet6_range": "c19:19:8:10::/92"
      }
    ],
    "rules": [
      {
        "preferred_by": "dns-mdns",
        "action": "route",
        "server": "dns-mdns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "geosite-private"
          },
          {
            "preferred_by": "dns-local"
          }
        ],
        "server": "dns-local"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "AAAA"
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "IPv4Only",
        "query_type": "AAAA",
        "action": "reject"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "clash_mode": "Global",
        "server": "dns-fake"
      },
      {
        "clash_mode": "Global",
        "server": "dns-remote"
      },
      {
        "rule_set": "@geosite-should-block",
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "geosite-category-ntp",
              "geosite-category-games@cn",
              "geosite-microsoft@cn",
              "geosite-apple@cn",
              "@geosite-direct",
              "@geosite-akamai@cn",
              "@geosite-steam@cn",
              "@geosite-google-play@cn",
              "@geosite-geolocation-cn"
            ]
          },
          {
            "port": [
              25,
              67,
              68,
              110,
              123,
              143,
              179,
              465,
              546,
              547,
              587,
              995,
              8899,
              8733
            ]
          },
          {
            "query_type": [
              "A",
              "AAAA"
            ],
            "invert": true
          }
        ],
        "action": "route",
        "server": "dns-cn"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "action": "route",
        "rewrite_ttl": 1,
        "server": "dns-fake"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns-local"
      },
      {
        "tag": "resolve-evaluate-ecs",
        "action": "evaluate",
        "server": "dns-ecs",
        "client_subnet": "0.0.0.0/0"
      },
      {
        "match_response": "resolve-evaluate-ecs",
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "invert": true,
        "action": "respond"
      },
      {
        "query_type": "A",
        "match_response": "resolve-evaluate-ecs",
        "rule_set": [
          "geoip-cn",
          "@geoip-direct"
        ],
        "ip_accept_any": true,
        "ip_is_private": true,
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "query_type": "AAAA",
        "match_response": "resolve-evaluate-ecs",
        "rule_set": [
          "geoip-cn",
          "@geoip-direct"
        ],
        "ip_accept_any": true,
        "ip_is_private": true,
        "response_rcode": "NOERROR",
        "action": "route",
        "server": "dns-cn"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": [
              "@geosite-fakeip-filter",
              "geosite-connectivity-check"
            ],
            "invert": true
          }
        ],
        "action": "route",
        "server": "dns-fake",
        "rewrite_ttl": 1
      }
    ],
    "final": "dns-remote",
    "reverse_mapping": true,
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    }
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "inbound": [
              "dns-in"
            ]
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "icmp"
          },
          {
            "port": [
              25,
              67,
              68,
              110,
              123,
              143,
              179,
              465,
              546,
              547,
              587,
              995,
              8899,
              8733
            ]
          },
          {
            "ip_is_private": true
          }
        ],
        "action": "route",
        "outbound": "🌐 Direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "ip_version": 6
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "IPv4Only",
        "ip_version": 6,
        "action": "reject"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "🙋 Select"
      },
      {
        "rule_set": "@geoip-telegram@dc5",
        "outbound": "✈️ TelegramDC5(AP)"
      },
      {
        "rule_set": "@geoip-telegram@dc1",
        "outbound": "✈️ TelegramDC1(NA)"
      },
      {
        "rule_set": "@geoip-telegram@dc4",
        "outbound": "✈️ TelegramDC4(EU)"
      },
      {
        "rule_set": [
          "@geoip-direct",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "🌐 Direct"
      },
      {
        "port": [
          80,
          443
        ],
        "network": "udp",
        "action": "reject"
      },
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "ssh"
        ],
        "timeout": "30ms"
      },
      {
        "rule_set": "@geosite-should-block",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-category-ntp",
          "geosite-category-games@cn",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "@geosite-direct",
          "@geosite-akamai@cn",
          "@geosite-steam@cn",
          "@geosite-google-play@cn",
          "@geosite-geolocation-cn"
        ],
        "action": "route",
        "outbound": "🌐 Direct"
      },
      {
        "rule_set": [
          "geosite-youtube"
        ],
        "action": "route",
        "outbound": "📺 Youtube"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "action": "route",
        "outbound": "🔍 Google"
      },
      {
        "rule_set": [
          "@geosite-category-ai-!cn",
          "geosite-category-ai-!cn"
        ],
        "outbound": "🤖 AI-Service"
      },
      {
        "rule_set": [
          "@geosite-category-dev",
          "geosite-github",
          "geosite-gitlab"
        ],
        "outbound": "🐈 Git"
      },
      {
        "rule_set": [
          "geosite-apple"
        ],
        "action": "route",
        "outbound": "🍎 Apple"
      },
      {
        "rule_set": "geosite-microsoft",
        "outbound": "📦 Microsoft"
      },
      {
        "rule_set": [
          "geosite-geolocation-cn"
        ],
        "outbound": "🌐 Direct"
      },
      {
        "rule_set": [
          "geosite-telegram",
          "@geosite-geolocation-eu"
        ],
        "outbound": "✈️ TelegramDC4(EU)"
      },
      {
        "rule_set": [
          "geosite-category-entertainment",
          "geosite-category-social-media-!cn",
          "geosite-reddit",
          "@geosite-cloudflare-challenge"
        ],
        "outbound": "🎬 Entertainment"
      }
    ],
    "rule_set": [
