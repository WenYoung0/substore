{
  "log": { "disabled": false, "level": "warn" },
  "dns": {
    "servers": [
      { "tag": "dns-bootstrap", "type": "udp", "server": "223.5.5.5" },
      { "tag": "dns-local", "type": "local" },
      { "tag": "dns-cn", "type": "https", "server": "223.5.5.5" },
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🙋 Select"
      },
      {
        "tag": "dns-fake",
        "type": "fakeip",
        "inet4_range": "32.81.0.0/16",
        "inet6_range": "5f00:7a61:b56:2170::/92"
      }
    ],
    "rules": [
      { "clash_mode": "Direct", "server": "dns-cn" },
      { "query_type": ["HTTPS", "SVCB"], "action": "reject" },
      { "clash_mode": "Global", "server": "dns-remote" },
      { "rule_set": "@geosite-block", "action": "reject" },
      { "rule_set": "geosite-private", "server": "dns-local" },
      { "rule_set": "geosite-netflix", "server": "dns-remote" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "domain_suffix": "cn",
            "rule_set": [
              "geosite-category-game-platforms-download@cn",
              "geosite-connectivity-check",
              "geosite-microsoft@cn",
              "geosite-apple@cn",
              "geosite-steam@cn",
              "geosite-epicgames@cn",
              "geosite-aws-cn",
              "geosite-azure@cn",
              "geosite-nvidia@cn",
              "geosite-itunes@cn",
              "geosite-paypal@cn",
              "geosite-akamai@cn",
              "geosite-linkedin@cn",
              "@geosite-steam@cn",
              "@geosite-direct",
              "@geosite-duolingo@cn",
              "@geosite-jetbrains@cn"
            ]
          }
        ],
        "server": "dns-cn"
      },
      {
        "query_type": ["A", "AAAA"],
        "rule_set": ["geosite-google", "geosite-microsoft"],
        "action": "route",
        "rewrite_ttl": 1,
        "server": "dns-fake"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": "geosite-geolocation-!cn", "invert": true },
          { "rule_set": ["geoip-cn", "@geoip-direct"] }
        ],
        "server": "dns-cn"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["@fakeip-filter"], "invert": true },
          { "query_type": ["A", "AAAA"] }
        ],
        "action": "route",
        "server": "dns-fake",
        "rewrite_ttl": 1
      }
    ],
    "final": "dns-remote",
    "independent_cache": true,
    "reverse_mapping": true
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "network": "udp", "port": [123] },
          { "clash_mode": "Direct" }
        ],
        "action": "route",
        "outbound": "Direct"
      },
      { "port": 53, "action": "hijack-dns" },
      { "clash_mode": "Global", "action": "route", "outbound": "🙋 Select" },
      { "ip_is_private": true, "action": "route", "outbound": "Direct" },
      {
        "rule_set": ["@geoip-direct", "geoip-cn"],
        "action": "route",
        "outbound": "Direct"
      },
      { "port": [80, 443], "network": "udp", "action": "reject" },
      { "rule_set": "@geoip-telegram@dc1", "outbound": "✈️ TelegramDC1(NA)" },
      { "rule_set": "@geoip-telegram@dc4", "outbound": "✈️ TelegramDC4(EU)" },
      { "rule_set": "@geoip-telegram@dc5", "outbound": "✈️ TelegramDC5(AP)" },
      {
        "action": "sniff",
        "sniffer": ["http", "tls", "quic", "ssh"],
        "timeout": "50ms"
      },
      { "rule_set": "@geosite-block", "action": "reject" },
      {
        "rule_set": ["geosite-private", "@geosite-direct"],
        "outbound": "Direct"
      },
      { "rule_set": "geosite-telegram", "outbound": "✈️ TelegramDC4(EU)" },
      {
        "rule_set": ["@geosite-category-ai-!cn", "geosite-category-ai-!cn"],
        "outbound": "🤖 AI-Service"
      },
      {
        "rule_set": [
          "@geosite-category-dev",
          "geosite-category-dev",
          "geosite-category-tech-media"
        ],
        "outbound": "💻 Dev"
      },
      { "rule_set": "geosite-google", "outbound": "🔍 Google" },
      { "rule_set": "geosite-microsoft@cn", "outbound": "Direct" },
      { "rule_set": "geosite-microsoft", "outbound": "🪟 Microsoft" },
      {
        "rule_set": [
          "geosite-geolocation-cn",
          "geosite-category-game-platforms-download@cn",
          "geosite-connectivity-check",
          "geosite-apple@cn",
          "geosite-steam@cn",
          "geosite-epicgames@cn",
          "geosite-aws-cn",
          "geosite-azure@cn",
          "geosite-nvidia@cn",
          "geosite-itunes@cn",
          "geosite-paypal@cn",
          "geosite-akamai@cn",
          "geosite-linkedin@cn",
          "@geosite-steam@cn",
          "@geosite-direct",
          "@geosite-duolingo@cn",
